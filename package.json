{
  "name": "tech-lead-trainer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "content:check": "node scripts/content.mjs check",
    "test": "vitest run --project core",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,supavisor,edge-runtime,realtime,storage-api,postgres-meta",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "env:local": "node scripts/write-local-env.mjs",
    "content:build": "node scripts/content.mjs build",
    "prebuild": "npm run content:check",
    "db:reset": "supabase db reset && supabase stop && npm run db:start",
    "rebuild:review-state": "node scripts/rebuild-review-state.mjs",
    "check:live-code": "node scripts/check-live-code-length.mjs",
    "backup:restore-check": "node scripts/backup.mjs restore-check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pg": "^8.23.1",
    "supabase": "^2.121.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module"
}
